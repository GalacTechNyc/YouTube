# Required: YouTube Data API v3 key (free) — see README
YOUTUBE_API_KEY=
# Strongly recommended: passcode the glasses must send (open the app once with ?key=...)
ACCESS_TOKEN=
# Country for the Hot tab (ISO 3166-1 alpha-2)
REGION=US
# Optional: Google sign-in (OAuth client type "TVs and Limited Input devices")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PORT=3000
